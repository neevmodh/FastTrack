# Supabase: pooled connection (port 6543, for the app at runtime)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase: direct connection (port 5432, used only for migrations)
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (photo storage) — create in Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Vision-LLM OCR for reading ONU labels (company name, MAC, etc). Gemini is
# tried first; Groq is the fallback if Gemini errors or isn't configured.
# Both have free tiers. Get keys at:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=""
GROQ_API_KEY=""
